<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TikTool</RootNamespace>
    <AssemblyName>TikTool</AssemblyName>
    <Product>Social Toolkit</Product>
    <AssemblyTitle>Social Toolkit</AssemblyTitle>
    <Version>1.0.0-beta.4</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>ThanhNguyenVN93</Company>
    <Copyright>© 2026 ThanhNguyenVN93</Copyright>
    <Description>Social Toolkit: download videos, unfollow inactive TikTok channels, unsubscribe inactive YouTube channels</Description>
    <ApplicationIcon>Resources\tiktool.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Playwright auto-installs ~150MB bundled Chromium after every build.
       This app always attaches to the user's real Chrome/Edge via CDP — bundled browsers
       are never needed. Override the target with an empty one to skip the download. -->
  <Target Name="PlaywrightInstall" />

  <!-- The Playwright package ships installer helpers for browsers on every operating system (PrintDeps.exe, reinstall_*.sh, reinstall_*.ps1).
       This app attaches to a browser that is already running and never installs one, so it does not use them; and security products flag some of
       them (Kaspersky deleted reinstall_msedge_dev_mac.sh and PrintDeps.exe from the unpacked release). Leave them out of every build and publish. -->
  <Target Name="DropPlaywrightInstallHelpers" AfterTargets="Build;Publish">
    <ItemGroup>
      <PlaywrightHelperFile Include="$(OutDir).playwright\package\bin\**" />
      <PlaywrightHelperFile Include="$(PublishDir).playwright\package\bin\**" Condition="'$(PublishDir)' != ''" />
    </ItemGroup>
    <Delete Files="@(PlaywrightHelperFile)" ContinueOnError="true" />
    <RemoveDir Directories="$(OutDir).playwright\package\bin;$(PublishDir).playwright\package\bin" ContinueOnError="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Guna.UI2.WinForms" Version="2.0.4.6" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="Microsoft.Playwright" Version="1.47.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Config\selectors.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- yt-dlp.exe / ffmpeg.exe are dropped here manually (not committed — see README/checklist);
         without this, YtDlpService.ResolveExecutable's "Resources\yt-dlp.exe next to the built
         exe" check silently never finds them, since AppContext.BaseDirectory is the build output
         folder, not this source folder. -->
    <!-- install.bat / portable.bat / uninstall.bat are only added to the release (publish) folder, not to dev builds. -->
    <None Include="Packaging\*.bat">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </None>
    <None Include="Resources\**" Condition="Exists('Resources')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Resources\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TikTool.Tests" />
  </ItemGroup>

</Project>
